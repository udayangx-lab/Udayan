{
  "name": "udayan-cinema",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/runtime.mjs dev",
    "build": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next build --webpack",
    "start": "node scripts/runtime.mjs start",
    "typecheck": "tsc --noEmit",
    "scrape": "node scripts/scrape.mjs",
    "sync:listings": "node scripts/sync-listings.mjs",
    "test:listings": "node --test tests/listings.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "cheerio": "latest"
  },
  "engines": {
    "node": ">=22.13"
  }
}
