# Copy to .env.local for development, and add the same values in Vercel → Project → Settings → Environment Variables.

# Neon Postgres. The Vercel Neon integration sets DATABASE_URL automatically.
# Leave empty locally to use an embedded Postgres (PGlite) in storage/pglite.
DATABASE_URL=

# Admin panel at /admin: sign in as "admin" with this password (at least 8 characters).
ADMIN_PASSWORD=
# Optional: 32+ random characters. Without it, a random signing key is generated and stored in the database.
ADMIN_SESSION_SECRET=

# Resend (https://resend.com). RESEND_FROM must use a domain verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM="Udayan Cinema <forms@udayancinema.com>"
# Fallback recipients (comma-separated) until recipients are saved under Admin → Email.
ADMIN_EMAIL=

# Public address of the site, used for "Open in admin panel" links in notification emails.
SITE_URL=https://udayancinema.com

# Protects /api/cron/listings. Vercel Cron sends it automatically once set. Use 16+ random characters.
CRON_SECRET=

# Local development only: where PGlite keeps its data. Ignored when DATABASE_URL is set.
DATA_DIR=storage
