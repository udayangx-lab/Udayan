# Copy to .env.local (development) or set in the server environment (production), then restart.

# Admin panel at /admin. One shared password, at least 8 characters.
ADMIN_PASSWORD=
# Optional: 32+ random characters. Without it, sessions are signed with a key derived from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Resend (https://resend.com). RESEND_FROM must use a domain verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM="Udayan Cinema <forms@udayancinema.com>"
# Fallback recipients (comma-separated) until recipients are saved under Admin → Email notifications.
ADMIN_EMAIL=

# Public address of the site, used for "Open in admin panel" links in notification emails.
SITE_URL=https://udayancinema.com

# Where the database, CVs, uploaded posters, and listings cache are kept. Must be persistent and backed up.
DATA_DIR=storage
